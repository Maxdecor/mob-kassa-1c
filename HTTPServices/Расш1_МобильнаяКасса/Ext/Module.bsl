// HTTP-сервис "Mobil kassa" для 1С:Управление нашей фирмой 3.0
// Аутентификация: Basic (пользователь 1С). Корневой URL: /mobkassa
//
// GET  /info                 - организации, склады, кассы ККМ, типы цен
// GET  /products             - поиск товаров (q, barcode, warehouse, pricetype, limit)
// GET  /receipts             - список чеков (from, to)
// GET  /receipts/{id}        - чек со списком товаров
// POST /receipts             - создать чек (deferred=true - отложенный, иначе пробить и провести)
// POST /receipts/{id}/post   - провести ранее отложенный чек
//
// Имена объектов УНФ 3.0 собраны в разделе "Настройки". Если в вашей версии
// имя отличается - правится только там.

#Область Настройки

// Измерение регистра цен и справочник типов (видов) цен определяем по метаданным:
// в разных редакциях УНФ они называются по-разному.
Функция ОписаниеТипаЦен()
	Результат = Новый Структура("Измерение,Справочник", "ТипЦен", "");
	Для Каждого Измерение Из Метаданные.РегистрыСведений.ЦеныНоменклатуры.Измерения Цикл
		Для Каждого ТипИзмерения Из Измерение.Тип.Типы() Цикл
			Мета = Метаданные.НайтиПоТипу(ТипИзмерения);
			Если Мета <> Неопределено И Метаданные.Справочники.Содержит(Мета)
				И Мета.Имя <> "Номенклатура" И СтрНайти(Мета.Имя, "Характеристик") = 0 Тогда
				Результат.Измерение = Измерение.Имя;
				Результат.Справочник = Мета.Имя;
				Возврат Результат;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ТипЦенИмяРеквизита()
	Возврат ОписаниеТипаЦен().Измерение;
КонецФункции

Функция ИмяСправочникаТипаЦен()
	Возврат ОписаниеТипаЦен().Справочник;
КонецФункции

Функция ИмяТЧТоваров()
	Для Каждого Имя Из СтрРазделить("Запасы,Товары", ",") Цикл
		Если Метаданные.Документы.ЧекККМ.ТабличныеЧасти.Найти(Имя) <> Неопределено Тогда
			Возврат Имя;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "В документе ЧекККМ не найдена табличная часть товаров";
КонецФункции

#КонецОбласти

#Область Обработчики

Функция ИнфоGET(Запрос)
	Попытка
		Данные = Новый Структура;
		Данные.Вставить("user", ИмяПользователя());
		Данные.Вставить("organizations", СписокСправочника("Справочник.Организации"));
		Данные.Вставить("warehouses", СписокСправочника("Справочник.СтруктурныеЕдиницы"));
		Данные.Вставить("cashRegisters", СписокСправочника("Справочник.КассыККМ"));
		Данные.Вставить("priceTypes", СписокСправочника("Справочник." + ИмяСправочникаТипаЦен()));
		Данные.Вставить("canSeeCost", ДоступКЗакупочнойЦене());
		Возврат Ответ(Данные);
	Исключение
		Возврат ОтветОшибка(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

Функция ТоварыGET(Запрос)
	Попытка
		Параметры = Запрос.ПараметрыЗапроса;
		Поиск = СокрЛП(Параметры.Получить("q"));
		Штрихкод = СокрЛП(Параметры.Получить("barcode"));
		Склад = СсылкаИзПараметра(Параметры.Получить("warehouse"), "СтруктурныеЕдиницы");
		ТипЦен = СсылкаИзПараметра(Параметры.Получить("pricetype"), ИмяСправочникаТипаЦен());
		Лимит = ЧислоИзПараметра(Параметры.Получить("limit"), 50);

		Запрос1 = Новый Запрос;
		Запрос1.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + "
		|	Н.Ссылка КАК Ссылка,
		|	Н.Код КАК Код,
		|	Н.Наименование КАК Наименование,
		|	Н.Артикул КАК Артикул,
		|	ПРЕДСТАВЛЕНИЕ(Н.ЕдиницаИзмерения) КАК Единица,
		|	ЕСТЬNULL(Ц.Цена, 0) КАК Цена,
		|	ЕСТЬNULL(О.Количество, 0) КАК Остаток,
		|	ЕСТЬNULL(Ш.Штрихкод, """") КАК Штрихкод
		|ИЗ
		|	Справочник.Номенклатура КАК Н
		|		ЛЕВОЕ СОЕДИНЕНИЕ (
		|			ВЫБРАТЬ
		|				Цены.Номенклатура КАК Номенклатура,
		|				МАКСИМУМ(Цены.Цена) КАК Цена
		|			ИЗ
		|				РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Дата, " + ТипЦенИмяРеквизита() + " = &ТипЦен) КАК Цены
		|			СГРУППИРОВАТЬ ПО
		|				Цены.Номенклатура) КАК Ц
		|		ПО Ц.Номенклатура = Н.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ (
		|			ВЫБРАТЬ
		|				Зап.Номенклатура КАК Номенклатура,
		|				СУММА(Зап.КоличествоОстаток) КАК Количество
		|			ИЗ
		|				РегистрНакопления.ЗапасыНаСкладах.Остатки(&Дата, &УчитыватьСклад = ЛОЖЬ ИЛИ СтруктурнаяЕдиница = &Склад) КАК Зап
		|			СГРУППИРОВАТЬ ПО
		|				Зап.Номенклатура) КАК О
		|		ПО О.Номенклатура = Н.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ (
		|			ВЫБРАТЬ
		|				ШК.Номенклатура КАК Номенклатура,
		|				МИНИМУМ(ШК.Штрихкод) КАК Штрихкод
		|			ИЗ
		|				РегистрСведений.ШтрихкодыНоменклатуры КАК ШК
		|			СГРУППИРОВАТЬ ПО
		|				ШК.Номенклатура) КАК Ш
		|		ПО Ш.Номенклатура = Н.Ссылка
		|ГДЕ
		|	НЕ Н.ПометкаУдаления
		|	И НЕ Н.ЭтоГруппа
		|	И &Условие
		|УПОРЯДОЧИТЬ ПО
		|	Н.Наименование";

		Если ЗначениеЗаполнено(Штрихкод) Тогда
			Условие = "Н.Ссылка В (ВЫБРАТЬ Ш2.Номенклатура ИЗ РегистрСведений.ШтрихкодыНоменклатуры КАК Ш2 ГДЕ Ш2.Штрихкод = &Штрихкод)";
			Запрос1.УстановитьПараметр("Штрихкод", Штрихкод);
		ИначеЕсли ЗначениеЗаполнено(Поиск) Тогда
			Условие = "(Н.Наименование ПОДОБНО &Поиск ИЛИ Н.Артикул ПОДОБНО &Поиск ИЛИ Н.Код ПОДОБНО &Поиск
			|	ИЛИ Н.Ссылка В (ВЫБРАТЬ Ш2.Номенклатура ИЗ РегистрСведений.ШтрихкодыНоменклатуры КАК Ш2 ГДЕ Ш2.Штрихкод ПОДОБНО &Поиск))";
			Запрос1.УстановитьПараметр("Поиск", "%" + Поиск + "%");
		Иначе
			Условие = "ИСТИНА";
		КонецЕсли;
		Запрос1.Текст = СтрЗаменить(Запрос1.Текст, "&Условие", Условие);
		Запрос1.УстановитьПараметр("Дата", ТекущаяДатаСеанса());
		Запрос1.УстановитьПараметр("ТипЦен", ТипЦен);
		Запрос1.УстановитьПараметр("Склад", Склад);
		Запрос1.УстановитьПараметр("УчитыватьСклад", ЗначениеЗаполнено(Склад));

		Результат = Новый Массив;
		Выборка = Запрос1.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Добавить(Новый Структура("id,code,name,article,unit,price,stock,barcode",
				ИдентификаторСсылки(Выборка.Ссылка), Выборка.Код, Выборка.Наименование, Выборка.Артикул,
				Выборка.Единица, Выборка.Цена, Выборка.Остаток, Выборка.Штрихкод));
		КонецЦикла;
		Возврат Ответ(Результат);
	Исключение
		Возврат ОтветОшибка(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

Функция ЧекиGET(Запрос)
	Попытка
		Параметры = Запрос.ПараметрыЗапроса;
		Сегодня = НачалоДня(ТекущаяДатаСеанса());
		От = НачалоДня(ПрочитатьДату(Параметры.Получить("from"), Сегодня - 7 * 86400));
		До = КонецДня(ПрочитатьДату(Параметры.Получить("to"), Сегодня));

		ЕстьСтатус = Метаданные.Документы.ЧекККМ.Реквизиты.Найти("Статус") <> Неопределено;

		Запрос1 = Новый Запрос;
		Запрос1.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 300
		|	Д.Ссылка КАК Ссылка,
		|	Д.Номер КАК Номер,
		|	Д.Дата КАК Дата,
		|	Д.Проведен КАК Проведен,
		|	" + ?(ЕстьСтатус, "ПРЕДСТАВЛЕНИЕ(Д.Статус)", """""") + " КАК Статус,
		|	ЕСТЬNULL(Т.Сумма, 0) КАК Сумма,
		|	ЕСТЬNULL(Т.Позиций, 0) КАК Позиций
		|ИЗ
		|	Документ.ЧекККМ КАК Д
		|		ЛЕВОЕ СОЕДИНЕНИЕ (
		|			ВЫБРАТЬ
		|				ТЧ.Ссылка КАК Ссылка,
		|				СУММА(ТЧ.Сумма) КАК Сумма,
		|				КОЛИЧЕСТВО(*) КАК Позиций
		|			ИЗ
		|				Документ.ЧекККМ." + ИмяТЧТоваров() + " КАК ТЧ
		|			СГРУППИРОВАТЬ ПО
		|				ТЧ.Ссылка) КАК Т
		|		ПО Т.Ссылка = Д.Ссылка
		|ГДЕ
		|	НЕ Д.ПометкаУдаления
		|	И Д.Дата МЕЖДУ &От И &До
		|УПОРЯДОЧИТЬ ПО
		|	Д.Дата УБЫВ";
		Запрос1.УстановитьПараметр("От", От);
		Запрос1.УстановитьПараметр("До", До);

		Результат = Новый Массив;
		Выборка = Запрос1.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Добавить(Новый Структура("id,number,date,posted,deferred,status,total,items",
				ИдентификаторСсылки(Выборка.Ссылка), Выборка.Номер, ДатаВСтроку(Выборка.Дата),
				Выборка.Проведен, НЕ Выборка.Проведен, Выборка.Статус, Выборка.Сумма, Выборка.Позиций));
		КонецЦикла;
		Возврат Ответ(Результат);
	Исключение
		Возврат ОтветОшибка(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

// Реквизит чека, по которому определяем продавца (кассира).
Функция ИмяПоляПродавца()
	Для Каждого Имя Из СтрРазделить("Ответственный,Автор", ",") Цикл
		Если Метаданные.Документы.ЧекККМ.Реквизиты.Найти(Имя) <> Неопределено Тогда
			Возврат Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// GET /top?from=2026-10-01&to=2026-10-24
// Итоги по проведенным чекам за период: топ товаров и топ продавцов.
Функция ТопGET(Запрос)
	Попытка
		Параметры = Запрос.ПараметрыЗапроса;
		Сегодня = НачалоДня(ТекущаяДатаСеанса());
		От = НачалоДня(ПрочитатьДату(Параметры.Получить("from"), Сегодня));
		До = КонецДня(ПрочитатьДату(Параметры.Получить("to"), Сегодня));
		ТЧ = ИмяТЧТоваров();
		ПолеПродавца = ИмяПоляПродавца();
		Условие = "Т.Ссылка.Проведен И НЕ Т.Ссылка.ПометкаУдаления И Т.Ссылка.Дата МЕЖДУ &От И &До";

		Запрос1 = Новый Запрос;
		Запрос1.УстановитьПараметр("От", От);
		Запрос1.УстановитьПараметр("До", До);

		Запрос1.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Т.Ссылка) КАК Чеков,
		|	ЕСТЬNULL(СУММА(Т.Сумма), 0) КАК Сумма
		|ИЗ
		|	Документ.ЧекККМ." + ТЧ + " КАК Т
		|ГДЕ
		|	" + Условие;
		Итог = Запрос1.Выполнить().Выбрать();
		Итог.Следующий();
		Чеков = Итог.Чеков;
		Всего = Итог.Сумма;

		Запрос1.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 20
		|	ПРЕДСТАВЛЕНИЕ(Т.Номенклатура) КАК Наименование,
		|	ПРЕДСТАВЛЕНИЕ(Т.Номенклатура.ЕдиницаИзмерения) КАК Единица,
		|	СУММА(Т.Количество) КАК Количество,
		|	СУММА(Т.Сумма) КАК Сумма
		|ИЗ
		|	Документ.ЧекККМ." + ТЧ + " КАК Т
		|ГДЕ
		|	" + Условие + "
		|СГРУППИРОВАТЬ ПО
		|	Т.Номенклатура
		|УПОРЯДОЧИТЬ ПО
		|	Сумма УБЫВ";
		Товары = Новый Массив;
		Выборка = Запрос1.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Товары.Добавить(Новый Структура("name,unit,quantity,sum",
				Выборка.Наименование, Выборка.Единица, Выборка.Количество, Выборка.Сумма));
		КонецЦикла;

		Продавцы = Новый Массив;
		Если ЗначениеЗаполнено(ПолеПродавца) Тогда
			Запрос1.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 20
			|	Т.Ссылка." + ПолеПродавца + " КАК Продавец,
			|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Т.Ссылка) КАК Чеков,
			|	СУММА(Т.Сумма) КАК Сумма
			|ИЗ
			|	Документ.ЧекККМ." + ТЧ + " КАК Т
			|ГДЕ
			|	" + Условие + "
			|СГРУППИРОВАТЬ ПО
			|	Т.Ссылка." + ПолеПродавца + "
			|УПОРЯДОЧИТЬ ПО
			|	Сумма УБЫВ";
			Выборка = Запрос1.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Продавцы.Добавить(Новый Структура("name,receipts,sum",
					Строка(Выборка.Продавец), Выборка.Чеков, Выборка.Сумма));
			КонецЦикла;
		КонецЕсли;

		Данные = Новый Структура;
		Данные.Вставить("total", Всего);
		Данные.Вставить("receipts", Чеков);
		Данные.Вставить("average", ?(Чеков = 0, 0, Окр(Всего / Чеков, 2)));
		Данные.Вставить("goods", Товары);
		Данные.Вставить("sellers", Продавцы);
		Возврат Ответ(Данные);
	Исключение
		Возврат ОтветОшибка(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

Функция ЧекGET(Запрос)
	Попытка
		Ссылка = Документы.ЧекККМ.ПолучитьСсылку(Новый УникальныйИдентификатор(Запрос.ПараметрыURL.Получить("id")));

		Запрос1 = Новый Запрос;
		Запрос1.Текст =
		"ВЫБРАТЬ
		|	ТЧ.НомерСтроки КАК Номер,
		|	ТЧ.Номенклатура.Наименование КАК Наименование,
		|	ТЧ.Номенклатура.Артикул КАК Артикул,
		|	ПРЕДСТАВЛЕНИЕ(ТЧ.Номенклатура.ЕдиницаИзмерения) КАК Единица,
		|	ТЧ.Количество КАК Количество,
		|	ТЧ.Цена КАК Цена,
		|	ТЧ.Сумма КАК Сумма
		|ИЗ
		|	Документ.ЧекККМ." + ИмяТЧТоваров() + " КАК ТЧ
		|ГДЕ
		|	ТЧ.Ссылка = &Ссылка
		|УПОРЯДОЧИТЬ ПО
		|	ТЧ.НомерСтроки";
		Запрос1.УстановитьПараметр("Ссылка", Ссылка);

		Строки = Новый Массив;
		Итого = 0;
		Выборка = Запрос1.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Строки.Добавить(Новый Структура("number,name,article,unit,quantity,price,sum",
				Выборка.Номер, Выборка.Наименование, Выборка.Артикул, Выборка.Единица, Выборка.Количество, Выборка.Цена, Выборка.Сумма));
			Итого = Итого + Выборка.Сумма;
		КонецЦикла;

		Данные = Новый Структура;
		Данные.Вставить("id", ИдентификаторСсылки(Ссылка));
		Данные.Вставить("number", Ссылка.Номер);
		Данные.Вставить("date", ДатаВСтроку(Ссылка.Дата));
		Данные.Вставить("posted", Ссылка.Проведен);
		Данные.Вставить("deferred", НЕ Ссылка.Проведен);
		Данные.Вставить("total", Итого);
		Данные.Вставить("lines", Строки);
		Возврат Ответ(Данные);
	Исключение
		Возврат ОтветОшибка(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

#Область Закупка

// Шаблон наименования типа цены, который считается закупочным (поиск ПОДОБНО).
Функция ШаблонЗакупочногоТипаЦен()
	Возврат "%закуп%";
КонецФункции

// Пользователь может видеть закупочную цену, если он внесен в регистр сведений
// "Расш1_ДоступКЗакупочнойЦене" с признаком "Разрешено". Проверка идет в привилегированном
// режиме, чтобы пользователям не нужны права на сам регистр.
Функция ДоступКЗакупочнойЦене()
	Если Метаданные.РегистрыСведений.Найти("Расш1_ДоступКЗакупочнойЦене") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		ИдИБ = ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор;
		Пользователь = Справочники.Пользователи.НайтиПоРеквизиту("ИдентификаторПользователяИБ", ИдИБ);
		Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
			Возврат Ложь;
		КонецЕсли;
		Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	1 КАК Признак
		|ИЗ
		|	РегистрСведений.Расш1_ДоступКЗакупочнойЦене КАК Р
		|ГДЕ
		|	Р.Пользователь = &Пользователь
		|	И Р.Разрешено");
		Запрос.УстановитьПараметр("Пользователь", Пользователь);
		Возврат НЕ Запрос.Выполнить().Пустой();
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Последняя цена товара по типу цены "закупочный". Неопределено, если не найдена.
Функция ЗакупочнаяЦена(Номенклатура)
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Ц.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Дата, Номенклатура = &Номенклатура) КАК Ц
	|ГДЕ
	|	Ц." + ТипЦенИмяРеквизита() + ".Наименование ПОДОБНО &Шаблон
	|	И Ц.Цена > 0
	|УПОРЯДОЧИТЬ ПО
	|	Ц.Период УБЫВ";
	Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Шаблон", ШаблонЗакупочногоТипаЦен());
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Цена;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// GET /cost?id=GUID - закупочная цена товара (только для разрешенных пользователей).
Функция ЗакупкаGET(Запрос)
	Попытка
		Если НЕ ДоступКЗакупочнойЦене() Тогда
			Возврат ОтветОшибка("Закупочная цена недоступна для вашего пользователя", 403);
		КонецЕсли;
		Идентификатор = Запрос.ПараметрыЗапроса.Получить("id");
		Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
			Возврат ОтветОшибка("Не указан товар", 400);
		КонецЕсли;
		Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
		Цена = ЗакупочнаяЦена(Номенклатура);
		Возврат Ответ(Новый Структура("found,price", Цена <> Неопределено, ?(Цена = Неопределено, 0, Цена)));
	Исключение
		Возврат ОтветОшибка(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область Возврат

// POST /receipts/{id}/return
// Тело (необязательно): {"lines":[{"lineNumber":1,"quantity":1}]}.
// Без lines - полный возврат. Создает и проводит документ "Чек ККМ на возврат".
Функция ЧекВозвратPOST(Запрос)
	Попытка
		Если Метаданные.Документы.Найти("ЧекККМВозврат") = Неопределено Тогда
			Возврат ОтветОшибка("В конфигурации нет документа ЧекККМВозврат", 501);
		КонецЕсли;
		Основание = Документы.ЧекККМ.ПолучитьСсылку(Новый УникальныйИдентификатор(Запрос.ПараметрыURL.Получить("id")));
		Если НЕ Основание.Проведен Тогда
			Возврат ОтветОшибка("Чек не проведен или не найден: возврат невозможен", 409);
		КонецЕсли;

		Выбранные = Неопределено;
		ТелоЗапроса = СокрЛП(Запрос.ПолучитьТелоКакСтроку());
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			Данные = ПрочитатьТело(Запрос);
			Выбранные = Данные.Получить("lines");
		КонецЕсли;

		Документ = Документы.ЧекККМВозврат.СоздатьДокумент();
		Документ.Заполнить(Основание);
		Документ.Дата = ТекущаяДатаСеанса();

		ОшибкаСмены = УстановитьСмену(Документ);
		Если ЗначениеЗаполнено(ОшибкаСмены) Тогда
			Возврат ОтветОшибка(ОшибкаСмены, 409);
		КонецЕсли;

		МетаВозврата = Документ.Метаданные();
		ИмяТЧ = "";
		Для Каждого Имя Из СтрРазделить("Запасы,Товары", ",") Цикл
			Если МетаВозврата.ТабличныеЧасти.Найти(Имя) <> Неопределено Тогда
				ИмяТЧ = Имя;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ИмяТЧ = "" Тогда
			Возврат ОтветОшибка("В документе возврата не найдена табличная часть товаров", 501);
		КонецЕсли;

		Если Выбранные <> Неопределено И Выбранные.Количество() > 0 Тогда
			ОбъектТЧ = МетаВозврата.ТабличныеЧасти[ИмяТЧ];
			Количества = Новый Соответствие;
			Для Каждого Позиция Из Выбранные Цикл
				Количества.Вставить(Число(Позиция.Получить("lineNumber")), Число(Позиция.Получить("quantity")));
			КонецЦикла;
			ТЧ = Документ[ИмяТЧ];
			Для Шаг = 1 По ТЧ.Количество() Цикл
				Индекс = ТЧ.Количество() - Шаг;
				Стр = ТЧ[Индекс];
				Количество = Количества.Получить(Индекс + 1);
				Если Количество = Неопределено ИЛИ Количество <= 0 Тогда
					ТЧ.Удалить(Индекс);
				Иначе
					Количество = Мин(Количество, Стр.Количество);
					Если Количество < Стр.Количество Тогда
						Стр.Количество = Количество;
						УстановитьРеквизитСтроки(Стр, ОбъектТЧ, "Сумма", Окр(Количество * Стр.Цена, 2));
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Если ТЧ.Количество() = 0 Тогда
				Возврат ОтветОшибка("Не выбрано ни одной строки для возврата", 400);
			КонецЕсли;
		КонецЕсли;

		Итого = 0;
		Для Каждого Стр Из Документ[ИмяТЧ] Цикл
			Итого = Итого + Стр.Сумма;
		КонецЦикла;

		Документ.Записать(РежимЗаписиДокумента.Проведение);
		Возврат Ответ(Новый Структура("id,number,total", ИдентификаторСсылки(Документ.Ссылка), Документ.Номер, Итого), 201);
	Исключение
		Возврат ОтветОшибка(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

#КонецОбласти

// Реквизит чека со ссылкой на кассовую смену ("Отчет о розничных продажах").
Функция РеквизитСмены(МетаДок = Неопределено)
	Если МетаДок = Неопределено Тогда
		МетаДок = Метаданные.Документы.ЧекККМ;
	КонецЕсли;
	Для Каждого Р Из МетаДок.Реквизиты Цикл
		Если СтрНайти(НРег(Р.Синоним), "розничн") > 0 ИЛИ СтрНайти(НРег(Р.Имя), "смен") > 0 Тогда
			Для Каждого ТипР Из Р.Тип.Типы() Цикл
				Мета = Метаданные.НайтиПоТипу(ТипР);
				Если Мета <> Неопределено И Метаданные.Документы.Содержит(Мета) Тогда
					Возврат Новый Структура("Реквизит,Документ", Р.Имя, Мета.Имя);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ПервыйРеквизит(Мета, Имена)
	Для Каждого Имя Из СтрРазделить(Имена, ",") Цикл
		Если Мета.Реквизиты.Найти(Имя) <> Неопределено Тогда
			Возврат Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Подставляет в чек открытую кассовую смену. Возвращает текст ошибки или "".
Функция УстановитьСмену(Документ)
	Смена = РеквизитСмены(Документ.Метаданные());
	Если Смена = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если ЗначениеЗаполнено(Документ[Смена.Реквизит]) Тогда
		Возврат "";
	КонецЕсли;

	МетаСмены = Метаданные.Документы[Смена.Документ];
	ПолеКассы = ПервыйРеквизит(МетаСмены, "КассаККМ,ККМ");
	ПолеСтатуса = ПервыйРеквизит(МетаСмены, "СтатусКассовойСмены,Статус,СостояниеКассовойСмены");
	КассаЧека = Неопределено;
	ПолеКассыЧека = ПервыйРеквизит(Документ.Метаданные(), "КассаККМ,ККМ");
	Если ПолеКассыЧека <> "" Тогда
		КассаЧека = Документ[ПолеКассыЧека];
	КонецЕсли;
	ФильтроватьПоКассе = ПолеКассы <> "" И ЗначениеЗаполнено(КассаЧека);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 30
	|	Д.Ссылка КАК Ссылка
	|ИЗ
	|	Документ." + Смена.Документ + " КАК Д
	|ГДЕ
	|	НЕ Д.ПометкаУдаления" + ?(ФильтроватьПоКассе, "
	|	И Д." + ПолеКассы + " = &Касса", "") + "
	|УПОРЯДОЧИТЬ ПО
	|	Д.Дата УБЫВ";
	Если ФильтроватьПоКассе Тогда
		Запрос.УстановитьПараметр("Касса", КассаЧека);
	КонецЕсли;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ПолеСтатуса = "" ИЛИ СтрНайти(НРег(Строка(Выборка.Ссылка[ПолеСтатуса])), "открыт") > 0 Тогда
			Документ[Смена.Реквизит] = Выборка.Ссылка;
			Возврат "";
		КонецЕсли;
	КонецЦикла;
	Возврат "Кассовая смена не открыта. Откройте смену в 1С (Отчет о розничных продажах) и повторите.";
КонецФункции

Функция ОписаниеТипов(Реквизит)
	Результат = Новый Массив;
	Для Каждого ТипР Из Реквизит.Тип.Типы() Цикл
		Мета = Метаданные.НайтиПоТипу(ТипР);
		Результат.Добавить(?(Мета = Неопределено, Строка(ТипР), Мета.ПолноеИмя()));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// GET /diag - реквизиты чека ККМ и документа кассовой смены (для настройки).
Функция ДиагGET(Запрос)
	Попытка
		Реквизиты = Новый Массив;
		Для Каждого Р Из Метаданные.Документы.ЧекККМ.Реквизиты Цикл
			Реквизиты.Добавить(Новый Структура("name,synonym,types", Р.Имя, Р.Синоним, ОписаниеТипов(Р)));
		КонецЦикла;
		Данные = Новый Структура;
		Данные.Вставить("receiptAttributes", Реквизиты);
		Данные.Вставить("tabularSection", ИмяТЧТоваров());
		Данные.Вставить("sellerField", ИмяПоляПродавца());
		Данные.Вставить("priceDimension", ТипЦенИмяРеквизита());
		Смена = РеквизитСмены();
		Если Смена = Неопределено Тогда
			Данные.Вставить("shift", "реквизит смены не найден");
		Иначе
			ДанныеСмены = Новый Массив;
			Для Каждого Р Из Метаданные.Документы[Смена.Документ].Реквизиты Цикл
				ДанныеСмены.Добавить(Новый Структура("name,synonym,types", Р.Имя, Р.Синоним, ОписаниеТипов(Р)));
			КонецЦикла;
			Данные.Вставить("shift", Новый Структура("receiptAttribute,document,attributes", Смена.Реквизит, Смена.Документ, ДанныеСмены));
		КонецЕсли;
		Возврат Ответ(Данные);
	Исключение
		Возврат ОтветОшибка(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

// Тело: {"organization":"guid","warehouse":"guid","cashRegister":"guid","priceType":"guid",
//        "deferred":false,"payment":"cash|card","lines":[{"id":"guid","quantity":2,"price":9500}]}
Функция ЧекиPOST(Запрос)
	Попытка
		Данные = ПрочитатьТело(Запрос);
		Отложен = Данные.Получить("deferred") = Истина;

		Строки = Данные.Получить("lines");
		Если Строки = Неопределено ИЛИ Строки.Количество() = 0 Тогда
			Возврат ОтветОшибка("Чек пустой: нет строк", 400);
		КонецЕсли;

		Документ = Документы.ЧекККМ.СоздатьДокумент();
		Документ.Заполнить(Неопределено);
		Документ.Дата = ТекущаяДатаСеанса();

		УстановитьРеквизит(Документ, "Организация", СсылкаИзПараметра(Данные.Получить("organization"), "Организации"));
		УстановитьРеквизит(Документ, "СтруктурнаяЕдиница", СсылкаИзПараметра(Данные.Получить("warehouse"), "СтруктурныеЕдиницы"));
		УстановитьРеквизит(Документ, "КассаККМ", СсылкаИзПараметра(Данные.Получить("cashRegister"), "КассыККМ"));
		УстановитьРеквизит(Документ, ТипЦенИмяРеквизита(), СсылкаИзПараметра(Данные.Получить("priceType"), ИмяСправочникаТипаЦен()));

		ОшибкаСмены = УстановитьСмену(Документ);
		Если ЗначениеЗаполнено(ОшибкаСмены) Тогда
			Возврат ОтветОшибка(ОшибкаСмены, 409);
		КонецЕсли;

		ИмяТЧ = ИмяТЧТоваров();
		ОбъектТЧ = Метаданные.Документы.ЧекККМ.ТабличныеЧасти[ИмяТЧ];
		СкладЧека = СсылкаИзПараметра(Данные.Получить("warehouse"), "СтруктурныеЕдиницы");
		Итого = 0;
		Для Каждого Позиция Из Строки Цикл
			Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Позиция.Получить("id")));
			Количество = Позиция.Получить("quantity");
			Цена = Позиция.Получить("price");
			Если Количество = Неопределено ИЛИ Количество <= 0 Тогда
				Возврат ОтветОшибка("Неверное количество в строке", 400);
			КонецЕсли;
			Стр = Документ[ИмяТЧ].Добавить();
			УстановитьРеквизитСтроки(Стр, ОбъектТЧ, "Номенклатура", Номенклатура);
			УстановитьРеквизитСтроки(Стр, ОбъектТЧ, "ЕдиницаИзмерения", Номенклатура.ЕдиницаИзмерения);
			УстановитьРеквизитСтроки(Стр, ОбъектТЧ, "Количество", Количество);
			УстановитьРеквизитСтроки(Стр, ОбъектТЧ, "Цена", Цена);
			УстановитьРеквизитСтроки(Стр, ОбъектТЧ, "Сумма", Окр(Количество * Цена, 2));
			УстановитьПоСинониму(Стр, ОбъектТЧ, "Склад", СкладЧека);
			УстановитьПоСинониму(Стр, ОбъектТЧ, "% НДС", СтавкаНДССтроки(ОбъектТЧ, Номенклатура));
			Итого = Итого + Окр(Количество * Цена, 2);
		КонецЦикла;
		УстановитьРеквизит(Документ, "СуммаДокумента", Итого);

		Если Отложен Тогда
			УстановитьСтатус(Документ, "Отлож");
			Документ.Записать(РежимЗаписиДокумента.Запись);
		Иначе
			УстановитьСтатус(Документ, "Пробит,Выбит");
			Документ.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;

		Возврат Ответ(Новый Структура("id,number,total,deferred",
			ИдентификаторСсылки(Документ.Ссылка), Документ.Номер, Итого, Отложен), 201);
	Исключение
		Возврат ОтветОшибка(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

Функция ЧекПровестиPOST(Запрос)
	Попытка
		Ссылка = Документы.ЧекККМ.ПолучитьСсылку(Новый УникальныйИдентификатор(Запрос.ПараметрыURL.Получить("id")));
		Документ = Ссылка.ПолучитьОбъект();
		Если Документ = Неопределено Тогда
			Возврат ОтветОшибка("Чек не найден", 404);
		КонецЕсли;
		УстановитьСтатус(Документ, "Пробит,Выбит");
		Документ.Записать(РежимЗаписиДокумента.Проведение);
		Возврат Ответ(Новый Структура("id,number,posted", ИдентификаторСсылки(Ссылка), Документ.Номер, Документ.Проведен));
	Исключение
		Возврат ОтветОшибка(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область Служебные

Функция Ответ(Данные, Код = 200)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Результат = Новый HTTPСервисОтвет(Код);
	Результат.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Результат.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Результат;
КонецФункции

Функция ОтветОшибка(Текст, Код = 500)
	Возврат Ответ(Новый Структура("error", Текст), Код);
КонецФункции

Функция ПрочитатьТело(Запрос)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());
	Возврат ПрочитатьJSON(Чтение, Истина);
КонецФункции

Функция ИдентификаторСсылки(Ссылка)
	Возврат Строка(Ссылка.УникальныйИдентификатор());
КонецФункции

Функция ДатаВСтроку(Дата)
	Возврат Формат(Дата, "ДФ=yyyy-MM-ddTHH:mm:ss");
КонецФункции

Функция ПрочитатьДату(Значение, ПоУмолчанию)
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Попытка
		Возврат XMLЗначение(Тип("Дата"), Значение);
	Исключение
		Возврат ПоУмолчанию;
	КонецПопытки;
КонецФункции

Функция ЧислоИзПараметра(Значение, ПоУмолчанию)
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Попытка
		Возврат Мин(Макс(Число(Значение), 1), 200);
	Исключение
		Возврат ПоУмолчанию;
	КонецПопытки;
КонецФункции

// ИмяСправочника - без префикса, например "КассыККМ"
Функция СсылкаИзПараметра(Значение, ИмяСправочника)
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Справочники[ИмяСправочника].ПустаяСсылка();
	КонецЕсли;
	Возврат Справочники[ИмяСправочника].ПолучитьСсылку(Новый УникальныйИдентификатор(Значение));
КонецФункции

Функция СписокСправочника(ПолноеИмя)
	Если Метаданные.НайтиПоПолномуИмени(ПолноеИмя) = Неопределено Тогда
		Возврат Новый Структура("missing", ПолноеИмя);
	КонецЕсли;
	Запрос =Новый Запрос("ВЫБРАТЬ Т.Ссылка КАК Ссылка, Т.Наименование КАК Наименование ИЗ " + ПолноеИмя + " КАК Т ГДЕ НЕ Т.ПометкаУдаления УПОРЯДОЧИТЬ ПО Т.Наименование");
	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Новый Структура("id,name", ИдентификаторСсылки(Выборка.Ссылка), Выборка.Наименование));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура УстановитьРеквизит(Объект, Имя, Значение)
	Если ЗначениеЗаполнено(Значение) И Объект.Метаданные().Реквизиты.Найти(Имя) <> Неопределено Тогда
		Объект[Имя] = Значение;
	КонецЕсли;
КонецПроцедуры

// Заполняет колонку табличной части по ее заголовку (синониму), если тип подходит.
Процедура УстановитьПоСинониму(Строка, ОбъектТЧ, Синоним, Значение)
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Р Из ОбъектТЧ.Реквизиты Цикл
		Если НРег(СокрЛП(Р.Синоним)) = НРег(Синоним) Тогда
			Если Р.Тип.СодержитТип(ТипЗнч(Значение)) Тогда
				Строка[Р.Имя] = Значение;
			КонецЕсли;
			Возврат;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Ставка НДС строки: из карточки товара, иначе элемент "Без НДС" того же справочника.
Функция СтавкаНДССтроки(ОбъектТЧ, Номенклатура)
	Ставка = Неопределено;
	Если Метаданные.Справочники.Номенклатура.Реквизиты.Найти("СтавкаНДС") <> Неопределено Тогда
		Ставка = Номенклатура.СтавкаНДС;
	КонецЕсли;
	Если ЗначениеЗаполнено(Ставка) Тогда
		Возврат Ставка;
	КонецЕсли;
	Для Каждого Р Из ОбъектТЧ.Реквизиты Цикл
		Если НРег(СокрЛП(Р.Синоним)) = "% ндс" Тогда
			Для Каждого ТипР Из Р.Тип.Типы() Цикл
				Мета = Метаданные.НайтиПоТипу(ТипР);
				Если Мета <> Неопределено И Метаданные.Справочники.Содержит(Мета) Тогда
					Найденная = Справочники[Мета.Имя].НайтиПоНаименованию("Без НДС", Истина);
					Если ЗначениеЗаполнено(Найденная) Тогда
						Возврат Найденная;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Процедура УстановитьРеквизитСтроки(Строка, ОбъектТЧ, Имя, Значение)
	Если ОбъектТЧ.Реквизиты.Найти(Имя) <> Неопределено Тогда
		Строка[Имя] = Значение;
	КонецЕсли;
КонецПроцедуры

// Если в чеке есть реквизит-перечисление "Статус", выбираем значение,
// имя которого начинается с одного из фрагментов (через запятую).
Процедура УстановитьСтатус(Документ, Фрагменты)
	Реквизит = Документ.Метаданные().Реквизиты.Найти("Статус");
	Если Реквизит = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого ТипРеквизита Из Реквизит.Тип.Типы() Цикл
		Для Каждого Перечисление Из Метаданные.Перечисления Цикл
			Если ТипРеквизита = Тип("ПеречислениеСсылка." + Перечисление.Имя) Тогда
				Для Каждого Значение Из Перечисление.ЗначенияПеречисления Цикл
					Для Каждого Фрагмент Из СтрРазделить(Фрагменты, ",") Цикл
						Если СтрНайти(НРег(Значение.Имя), НРег(Фрагмент)) = 1 Тогда
							Документ.Статус = Перечисления[Перечисление.Имя][Значение.Имя];
							Возврат;
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
